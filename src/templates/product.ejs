<section id="product-details">
    <div class="wrapper">
        <ul class="breadcrumbs">
            <li class="prev-link"><a href="<%= firstPageUrl %> "><%= firstPage %></a></li>
            <li class="prev-link"><a href="<%= previousPageUrl %> "><%= previousPage %></a></li>
            <li class="current-link"><%= currentPage %></li>
        </ul>
        <h6>Ruffle Front V-Neck Cardigan</h6>
        <div class="product-info">
            <div class="row">
                <div class="col">
                    <div id="product-gallery">
                        <div class="gallery-big-image">
                            <img src="../img/product_gallery_big1.jpg" alt="product-image">
                            <span id="gallery-enlarge-button" class="fas fa-expand-arrows-alt"></span>
                        </div>
                        <ul class="gallery-images-list">
                            <li>
                                <img class="gallery-small-image active" src="../img/product_gallery_big1.jpg" alt="product-image">
                            </li>
                            <li>
                                <img class="gallery-small-image" src="../img/product_gallery_big2.jpg" alt="product-image">
                            </li>
                            <li>
                                <img class="gallery-small-image" src="../img/product_gallery_big3.jpg" alt="product-image">
                            </li>
                            <li>
                                <img class="gallery-small-image" src="../img/product_gallery_big4.jpg" alt="product-image">
                            </li>
                        </ul>
                        <div id="gallery-modal" class="modal-container">
                            <div class="overlay" data-modal="close"></div>
                            <img class="gallery-enlarged-image" alt="product-image">
                        </div>
                    </div>
                </div>
                <div class="col">

                </div>
            </div>
        </div>
    </div>
</section>