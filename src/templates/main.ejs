<div id="login-modal" class="modal-container">
    <div class="overlay" data-modal="close"></div>
    <div class="modal">
        <h4>Sign in</h4>
        <form id="login-form">
            <label>Email
                <input type="email" required>
            </label>
            <label>Password
                <a href="forgot-password" data-navigo>Forgot password</a>
                <input id="user-pass" title="at least 1 numeric, 1 uppercase, 1 lowercase and 1 special character"
                    type="password" minlength="6" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[!@#\$%\^&\*]).{6,}"
                    required>
                <span class="fa fa-fw fa-eye password-show"></span>
            </label>
            <button id="login-form-button" type="submit" name="password">Login</button>
        </form>
        <a href="create-account" data-navigo>I don't have an account</a>
    </div>
</div>
<div id="cookies-message" class="modal-container">
    <div class="overlay" data-modal="close"></div>
    <div class="modal">
        <span class="fas fa-times" data-modal="close"></span>
        <h2>This website uses cookies</h2>
        <p>OSF uses its own and third-party cookies for statistical purposes, to know your preferences, for website
            performance
            and interaction with social media offering publicity tailored to your interests. If you continue browsing,
            we consider that you accept its use.
            You can expand this information consulting our <a href="cookies-policy" data-navigo>Cookies Policy Page.</a>
        </p>
        <button id="cookies-accept-button" data-modal="close">Accept</button>
    </div>
</div>
