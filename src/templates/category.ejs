<section id="category-landing">
    <div class="wrapper">
        <ul class="breadcrumbs">
            <li class="prev-link"><a href="<%= previousPageUrl %>"><%= previousPage %></a></li>
            <li class="current-link"><%= currentPage %></li>
        </ul>
        <h6>Services</h6>
        <div class="filters">
            <div class="row">
                <div class="col">
                    <label>
                        <span>Price</span>
                        <select>
                            <option>$0 - $100</option>
                            <option>$100 - $500</option>
                        </select>
                    </label>
                    <div class="color-picker">
                        <span>Color</span>
                        <ul>
                            <li style="background-color: #ffffff; border: 3px solid #45413e;"></li>
                            <li style="background-color: #3d402f;"></li>
                            <li style="background-color: #4aaf00;"></li>
                            <li style="background-color: #315bbd;"></li>
                            <li style="background-color: #ec6115;"></li>
                            <li style="background-color: #dc041d;"></li>
                            <li style="background-color: #efead7;"></li>
                        </ul>
                    </div>
                </div>
                <div class="col">
                    <label>
                        <span>Brands</span>
                        <select>
                            <option>Ukraine sport</option>
                            <option>Puma</option>
                        </select>
                    </label>
                    <label>
                        <span>Sort by</span>
                        <select>
                            <option>Price</option>
                            <option>Brand</option>
                        </select>
                    </label>
                </div>
                <div class="col">
                    <label>
                        <span>Size</span>
                        <select>
                            <option>Small</option>
                            <option>Big</option>
                        </select>
                    </label>
                    <label>
                        <span>Show</span>
                        <select>
                            <option>16 per page</option>
                            <option>50 per page</option>
                        </select>
                    </label>
                </div>
            </div>
        </div>
        <div class="products-container">
            <article class="product-tile">
                <img src="img/product_1.png" alt="product image">
                <p class="product-tile-desc">Kristina Dam Oak Table With White Marble Top </p>
                <span class="product-tile-price">$ 799.55</span>
                <div class="product-tile-hover"></div>
                <button type="button" class="product-tile-hover-button add-to-cart-button fas fa-plus"></button>
                <button type="button" class="product-tile-hover-button add-to-wishlist-button fas fa-heart"></button>
            </article>
            <article class="product-tile">
                <img src="img/product_1.png" alt="product image">
                <p class="product-tile-desc">Kristina Dam Oak Table With White Marble Top </p>
                <button type="button" class="product-tile-button">
                    <span class="product-tile-button-price">$799.55</span>
                    <span>buy now</span>
                </button>
            </article>
            <article class="product-tile">
                <img src="img/static_product_tile.png" alt="static product image">
                <div class="product-tile-overlay"></div>
                <p class="product-tile-overlay-text">
                    My dragons are
                    misbehaving again.
                    Unbelieveable!
                </p>
                <span class="fas fa-user"></span>
                <span class="product-tile-time">5h ago</span>
            </article>
            <article class="product-tile">
                <img src="img/product_1.png" alt="product image">
                <p class="product-tile-desc">Kristina Dam Oak Table With White Marble Top </p>
                <span class="product-tile-price">$ 799.55</span>
            </article>
            <article class="product-tile">
                <img src="img/product_1.png" alt="product image">
                <p class="product-tile-desc">Kristina Dam Oak Table With White Marble Top </p>
                <span class="product-tile-feature">Awesome</span>
            </article>
        </div>
        <button id="category-load-more-button">Load more</button>
    </div>
</section>